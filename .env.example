# ── ERP Anomaly Detector Environment Configuration ──

# Application Profile
APP_NAME="ERP Anomaly Detector"
APP_VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000
RELOAD=true
BACKEND_URL="http://127.0.0.1:8000"
CORS_ORIGINS="*"

# Optional Authorization Key (Require authentication when true)
REQUIRE_API_KEY=false
API_KEY="your_secure_secret_api_key"

# Artifact File Paths
MODEL_PATH="artifacts/model.pkl"
SCALER_PATH="artifacts/scaler.pkl"
FEATURE_COLS_PATH="artifacts/feature_cols.pkl"
METADATA_PATH="artifacts/model_metadata.json"
DATA_PATH="data/creditcard.csv"

# Centralized Logging Properties
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

# Decision Thresholds
FRAUD_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.8

# JWT Authentication Configuration
# IMPORTANT: Generate secure secrets before deploying!
# Use: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="CHANGE_ME_generate_a_secure_random_secret"
JWT_REFRESH_SECRET_KEY="CHANGE_ME_generate_a_secure_random_refresh_secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
